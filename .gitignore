# 大型資料/權重/實驗輸出 — 不進版控
dataset/*
dataset.zip
runs/
runs.zip
models/
wandb/
video/

# dataset/ 整包被忽略，但 dataset/reid/ 底下的程式碼/文件例外要進版控
# （用 dataset/* 而非 dataset/ 是必要的：git 對「整個目錄」規則會直接剪枝不再往下比對，
#  下面的例外規則就不會生效；逐層用 /* 展開才能讓子目錄的例外規則正常運作）
!dataset/reid/
dataset/reid/*
!dataset/reid/README.md
!dataset/reid/build_reid_split.py
!dataset/reid/check_class_consistency.py
!dataset/reid/generate_identity_review.py
!dataset/reid/quarantine_flagged.py

# Python
__pycache__/
*.pyc

# macOS
.DS_Store

# 權重檔（若散落在其他目錄）
*.pt
*.pth
*.onnx
*.engine

# 大型素材/子模組/工具索引快取 — 不進版控
Sub_Module/
bus_video/
ignore/
.codegraph/

# Claude Code 技能套件鏡像（工具快取，非專案內容）
.claude/skills/
.agents/

# Python packaging
*.egg-info/
build/
