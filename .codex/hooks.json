{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -Eq '(^|[^[:alnum:]_])git[[:space:]]+commit([^[:alnum:]_]|$)'; then '/mnt/moris/Dcoker_Project/Project/safetrajai_eval/.codex/hooks/before-commit-check.sh'; fi",
            "timeout": 60
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codegraph prompt-hook"
          }
        ]
      }
    ]
  }
}
